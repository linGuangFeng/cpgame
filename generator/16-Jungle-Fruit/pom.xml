<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.cpgame.batcha</groupId>
  <artifactId>jungle-fruit-generator</artifactId>
  <version>1.0.0</version>
  <name>Jungle Fruit raw gid 16 complete-Round generator</name>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <build>
    <finalName>jungle-fruit-loader</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest><mainClass>com.cpgame.batcha.g16.LoaderMain</mainClass></manifest>
            <manifestEntries>
              <Jungle-Fruit-Raw-Game-Id>16</Jungle-Fruit-Raw-Game-Id>
              <Rules-Version>jf16-evidence-2026-08-30-v2</Rules-Version>
              <Rules-Hash>e53fffb1bc81b26725d44f1522b44b050eb21f93063de0c6a3a0c241adc3f7e2</Rules-Hash>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
