  "stateMachine": {
    "states": ["UNINITIALIZED","CONFIGURED","AUTHENTICATED","ROOM_READY","PAID_REQUEST_IN_FLIGHT","ORDINARY_TERMINAL","FEATURE_SELECTION_CODE_PATH","FREE_STEP_CODE_PATH","FEATURE_TERMINAL_CODE_PATH","RECOVERY"],
    "confirmedTransitions": [
      {"from":"UNINITIALIZED","to":"CONFIGURED","event":"initialData code=0"},
      {"from":"CONFIGURED","to":"AUTHENTICATED","event":"getUserInfo code=0"},
      {"from":"AUTHENTICATED","to":"ROOM_READY","event":"initRoom code=0; replay is not a paid start"},
      {"from":"ROOM_READY","to":"PAID_REQUEST_IN_FLIGHT","event":"gameResult type=1 game_type=1"},
      {"from":"PAID_REQUEST_IN_FLIGHT","to":"ORDINARY_TERMINAL","event":"gt=1, small_game_type=0, f=[], non-array response data, no active feature"},
      {"from":"ORDINARY_TERMINAL","to":"ROOM_READY","event":"UI finishes result presentation"},
      {"from":"PAID_REQUEST_IN_FLIGHT","to":"RECOVERY","event":"network error, BET_BUSY/BET_ERROR or data=[]"},
      {"from":"RECOVERY","to":"ROOM_READY","event":"initRoom/retry produces stable room data; never index recovery as a paid start"}
