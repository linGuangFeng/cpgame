      {"from":"FREE_STEP_CODE_PATH","to":"FREE_STEP_CODE_PATH","event":"f.st remains positive / Hold-and-Spins new Coin alters count","status":"STATE_FIELDS_CODE_ONLY"},
      {"from":"FREE_STEP_CODE_PATH","to":"FEATURE_TERMINAL_CODE_PATH","event":"f.st reaches terminal condition or Hold grid reaches 15","status":"RULE_AND_CODE_ONLY"},
      {"from":"FEATURE_TERMINAL_CODE_PATH","to":"ROOM_READY","event":"feature total presentation closes","status":"UI_CODE_ONLY"}
    ],
    "roundAndStepBoundaryRules": [
      "Only a type=1 game_type=1 gameResult request is indexed as a paid Round start in current evidence.",
