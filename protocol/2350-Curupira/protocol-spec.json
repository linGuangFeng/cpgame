      "contentType": "application/json; charset=utf-8",
      "encryption": "none observed",
      "successEnvelope": {"httpStatus":200,"code":0,"msg":"success","time":"server epoch seconds string"},
      "retryEvidence": [
        "gameResult data=[] is treated as an incomplete/busy sentinel and triggers retryGameResult",
        "BET_BUSY/BET_ERROR and network failure route through initRoom recovery",
        "initRoom returning the same oid as the already held room state routes to gameResult recovery rather than indexing a new paid Round"
      ]
