    "codeOnlyUnconfirmedTransitions": [
      {"from":"PAID_REQUEST_IN_FLIGHT","to":"FEATURE_SELECTION_CODE_PATH","event":"3+ Scatter and f object expected","status":"NO_RUNTIME_RESPONSE"},
