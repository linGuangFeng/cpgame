        "expireField": "expire",
        "expireSemantics": "server-adjusted epoch milliseconds",
        "canonicalization": "sort original parameter keys ascending and join key=value pairs with ':'",
        "formula": "lowercaseHex(MD5(secret + expire + canonicalizedOriginalParameters + 'aptsignature'))",
        "mutationOrder": ["build unsigned field object","read server-adjusted milliseconds","calculate signapt without signapt/expire in the canonical field set","add signapt","add expire","form encode all fields"],
