    "identifierPrecision": {
      "fields": ["rid","oid"],
      "finding": "captured identifiers exceed 2^53-1",
      "wireImplementation": "Java long is sufficient for observed 19-digit positive values; browser-facing code must also retain a decimal-string representation",
